# RPC endpoints used by the browser. NEXT_PUBLIC_* values are embedded in the
# client bundle, so never put a secret (e.g. a paid RPC API key you must hide) here.
# Leave a value empty to use the default public endpoint.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
