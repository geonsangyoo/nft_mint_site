{
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:solidity": "hardhat test solidity",
    "test:nodejs": "hardhat test nodejs",
    "typecheck": "hardhat build && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:local": "hardhat ignition deploy ignition/modules/DAppsNft.ts",
    "deploy:sepolia": "hardhat ignition deploy ignition/modules/DAppsNft.ts --network sepolia --verify",
    "deploy:fuji": "hardhat ignition deploy ignition/modules/DAppsNft.ts --network fuji --verify"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "hardhat": "^3.18.0"
  },
  "devDependencies": {
    "@avalabs/avalanchejs": "^5.2.0",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.4",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "prettier": "^3.9.9",
    "prettier-plugin-solidity": "^2.4.1",
    "typescript": "~6.0.3",
    "viem": "^2.56.9"
  }
}
